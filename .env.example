# Django
SECRET_KEY=change-me-to-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL) — set USE_SQLITE=True for local dev without PostgreSQL
USE_SQLITE=False
DB_NAME=mistnleaf
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Timezone
TIME_ZONE=Asia/Kolkata

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS — public site (3000) + admin dashboard (3001)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
CORS_ALLOW_CREDENTIALS=True

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Business rules
MISTNLEAF_TAX_RATE=0.12

# CMS — admin dashboard saves content via NEXT_PUBLIC_CMS_API_URL=http://127.0.0.1:3001
# CORS must include admin origin (port 3000) — configured in CORS_ALLOWED_ORIGINS above
#
# CMS API endpoints:
#   GET  /api/cms/                  — published content (public)
#   GET  /api/cms/content/          — full CMS document (editors)
#   PUT  /api/cms/content/          — save CMS document (editors)
#   POST /api/cms/media/upload/     — upload image (editors, JWT or X-Mistnleaf-Role-Id)
#   GET  /api/cms/media/            — list uploads (editors)
#
# Enquiries & bookings:
#   POST /api/public/enquiries/     — contact form (public)
#   POST /api/public/bookings/      — website booking request (public)
#   GET  /api/staff/enquiries/      — staff inbox (JWT, manage_enquiries)
#   GET  /api/staff/bookings/       — staff reservations (JWT, manage_bookings)
